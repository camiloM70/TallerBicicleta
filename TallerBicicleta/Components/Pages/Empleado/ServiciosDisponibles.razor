@page "/empleado/servicios-disponibles"
@attribute [Authorize(Roles = "Empleado")]
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILogger<ServiciosDisponibles> Logger

<PageTitle>Servicios Disponibles</PageTitle>

<div class="page-container">
    <!-- Header -->
    <div class="page-header">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center py-3">
                <div>
                    <button class="btn btn-light btn-sm me-3" @onclick='() => Navigation.NavigateTo("/empleado")'>
                        <i class="fas fa-arrow-left me-2"></i>Volver
                    </button>
                    <h1 class="d-inline mb-0">
                        <i class="fas fa-clipboard-list me-2"></i>Servicios Disponibles
                    </h1>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenido -->
    <div class="container-fluid px-4 mt-4">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-exclamation-circle me-2"></i>@errorMessage
                <button type="button" class="btn-close" @onclick="@(() => errorMessage = null)"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle me-2"></i>@successMessage
                <button type="button" class="btn-close" @onclick="@(() => successMessage = null)"></button>
            </div>
        }

        @if (cargando)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-warning" style="width: 3rem; height: 3rem;"></div>
                <p class="mt-3">Cargando solicitudes pendientes...</p>
            </div>
        }
        else if (solicitudes == null || !solicitudes.Any())
        {
            <div class="card shadow-lg border-0">
                <div class="card-body text-center py-5">
                    <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                    <h4>No hay servicios disponibles</h4>
                    <p class="text-muted">No hay solicitudes pendientes en este momento</p>
                    <button class="btn btn-primary" @onclick="CargarSolicitudes">
                        <i class="fas fa-sync me-2"></i>Actualizar
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var solicitud in solicitudes.OrderBy(s => s.FechaSolicitud))
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 shadow border-0 solicitud-card">
                            <div class="card-header bg-warning text-white">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">
                                        <span class="badge bg-dark me-2">#@solicitud.Id?.Substring(0, 8)</span>
                                        Solicitud Pendiente
                                    </h5>
                                    <span class="badge bg-light text-dark">
                                        <i class="fas fa-clock me-1"></i>Pendiente
                                    </span>
                                </div>
                            </div>
                            <div class="card-body">
                                <p class="card-text mb-2">
                                    <i class="fas fa-user text-primary me-2"></i>
                                    <strong>Cliente:</strong> @solicitud.ClienteNombre
                                </p>

                                <p class="card-text mb-2">
                                    <i class="fas fa-calendar-alt text-info me-2"></i>
                                    <strong>Solicitado:</strong> @solicitud.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </p>

                                <hr />

                                <p class="card-text">
                                    <i class="fas fa-align-left text-success me-2"></i>
                                    <strong>Descripción:</strong>
                                </p>
                                <p class="text-muted small bg-light p-2 rounded">@solicitud.Descripcion</p>

                                @if (!string.IsNullOrEmpty(solicitud.Detalle))
                                {
                                    <p class="card-text mt-2">
                                        <i class="fas fa-info-circle text-warning me-2"></i>
                                        <strong>Detalles:</strong>
                                    </p>
                                    <p class="text-muted small bg-light p-2 rounded" style="white-space: pre-line;">@solicitud.Detalle</p>
                                }
                            </div>
                            <div class="card-footer bg-transparent">
                                <button class="btn btn-success w-100" @onclick="() => TomarServicio(solicitud)" disabled="@tomando">
                                    @if (tomando && solicitudSeleccionada?.Id == solicitud.Id)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-hand-paper me-2"></i>
                                    }
                                    Tomar Servicio
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .page-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
    }

    .page-header {
        background: linear-gradient(135deg, #ff9800 0%, #f57c00 100%);
        color: white;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .solicitud-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .solicitud-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.15) !important;
        }

    .btn-success {
        background: linear-gradient(135deg, #66bb6a 0%, #4caf50 100%);
        border: none;
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #4caf50 0%, #388e3c 100%);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(76, 175, 80, 0.4);
        }
</style>

@code {
    private List<SolicitudServicio>? solicitudes;
    private SolicitudServicio? solicitudSeleccionada;
    private string? errorMessage;
    private string? successMessage;
    private bool cargando = false;
    private bool tomando = false;

    private string? empleadoId;
    private string? empleadoNombre;

    protected override async Task OnInitializedAsync()
    {
        await ObtenerDatosEmpleado();
        await CargarSolicitudes();
    }

    private async Task ObtenerDatosEmpleado()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                empleadoId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                empleadoNombre = user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;

                Logger.LogInformation($"Empleado autenticado: {empleadoNombre} (ID: {empleadoId})");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al obtener datos del empleado");
        }
    }

    private async Task CargarSolicitudes()
    {
        try
        {
            cargando = true;
            errorMessage = null;

            // Obtener todas las solicitudes
            var response = await Http.GetAsync("api/solicitud");

            if (response.IsSuccessStatusCode)
            {
                var todasSolicitudes = await response.Content.ReadFromJsonAsync<List<SolicitudServicio>>() ?? new List<SolicitudServicio>();

                // Filtrar solo las pendientes
                solicitudes = todasSolicitudes
                    .Where(s => s.Estado == (int)EstadoSolicitud.Pendiente)
                    .ToList();

                Logger.LogInformation($"Solicitudes pendientes cargadas: {solicitudes.Count}");
            }
            else
            {
                errorMessage = "Error al cargar las solicitudes";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Logger.LogError(ex, "Error al cargar solicitudes");
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task TomarServicio(SolicitudServicio solicitud)
    {
        try
        {
            tomando = true;
            solicitudSeleccionada = solicitud;
            errorMessage = null;
            successMessage = null;

            Logger.LogInformation($"Empleado {empleadoNombre} tomando servicio: {solicitud.Id}");

            // Crear el DTO para asignar
            var asignarDto = new
            {
                EmpleadoId = empleadoId,
                EmpleadoNombre = empleadoNombre
            };

            var response = await Http.PutAsJsonAsync($"api/solicitud/{solicitud.Id}/asignar", asignarDto);

            if (response.IsSuccessStatusCode)
            {
                successMessage = $"¡Servicio tomado exitosamente! Ahora puedes generar la factura.";
                Logger.LogInformation($"Servicio {solicitud.Id} asignado a {empleadoNombre}");

                // Recargar lista
                await Task.Delay(1500);
                await CargarSolicitudes();

                successMessage = null;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error al tomar el servicio: {error}";
                Logger.LogError($"Error al asignar servicio: {error}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Logger.LogError(ex, "Error al tomar servicio");
        }
        finally
        {
            tomando = false;
            solicitudSeleccionada = null;
        }
    }
}
