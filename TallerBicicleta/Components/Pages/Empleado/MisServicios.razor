@page "/empleado/mis-servicios"
@attribute [Authorize(Roles = "Empleado")]
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILogger<MisServicios> Logger

<PageTitle>Mis Servicios</PageTitle>

<div class="page-container">
    <!-- Header -->
    <div class="page-header">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center py-3">
                <div>
                    <button class="btn btn-light btn-sm me-3" @onclick='() => Navigation.NavigateTo("/empleado")'>
                        <i class="fas fa-arrow-left me-2"></i>Volver
                    </button>
                    <h1 class="d-inline mb-0">
                        <i class="fas fa-tasks me-2"></i>Mis Servicios En Proceso
                    </h1>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenido -->
    <div class="container-fluid px-4 mt-4">
        @if (cargando)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-success" style="width: 3rem; height: 3rem;"></div>
                <p class="mt-3">Cargando mis servicios...</p>
            </div>
        }
        else if (solicitudes == null || !solicitudes.Any())
        {
            <div class="card shadow-lg border-0">
                <div class="card-body text-center py-5">
                    <i class="fas fa-tasks fa-4x text-muted mb-3"></i>
                    <h4>No tienes servicios en proceso</h4>
                    <p class="text-muted">Toma solicitudes desde "Servicios Disponibles"</p>
                    <button class="btn btn-warning" @onclick='() => Navigation.NavigateTo("/empleado/servicios-disponibles")'>
                        <i class="fas fa-search me-2"></i>Ver Disponibles
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var solicitud in solicitudes.OrderBy(s => s.FechaAsignacion))
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 shadow border-0 solicitud-card">
                            <div class="card-header bg-success text-white">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">
                                        <span class="badge bg-dark me-2">#@solicitud.Id?.Substring(0, 8)</span>
                                        En Proceso
                                    </h5>
                                    <span class="badge bg-light text-success">
                                        <i class="fas fa-cog fa-spin me-1"></i>Activo
                                    </span>
                                </div>
                            </div>
                            <div class="card-body">
                                <p class="card-text mb-2">
                                    <i class="fas fa-user text-primary me-2"></i>
                                    <strong>Cliente:</strong> @solicitud.ClienteNombre
                                </p>

                                <p class="card-text mb-2">
                                    <i class="fas fa-calendar-alt text-info me-2"></i>
                                    <strong>Solicitado:</strong> @solicitud.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </p>

                                @if (solicitud.FechaAsignacion.HasValue)
                                {
                                    <p class="card-text mb-2">
                                        <i class="fas fa-hand-paper text-success me-2"></i>
                                        <strong>Tomado:</strong> @solicitud.FechaAsignacion.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </p>
                                }

                                <hr />

                                <p class="card-text">
                                    <i class="fas fa-align-left text-success me-2"></i>
                                    <strong>Descripción:</strong>
                                </p>
                                <p class="text-muted small bg-light p-2 rounded">@solicitud.Descripcion</p>

                                @if (!string.IsNullOrEmpty(solicitud.Detalle))
                                {
                                    <p class="card-text mt-2">
                                        <i class="fas fa-info-circle text-warning me-2"></i>
                                        <strong>Detalles:</strong>
                                    </p>
                                    <p class="text-muted small bg-light p-2 rounded" style="white-space: pre-line;">@solicitud.Detalle</p>
                                }
                            </div>
                            <div class="card-footer bg-transparent">
                                <button class="btn btn-primary w-100" @onclick='() => Navigation.NavigateTo($"/empleado/generar-factura/{solicitud.Id}")'>
                                    <i class="fas fa-file-invoice-dollar me-2"></i>Generar Factura
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .page-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
    }

    .page-header {
        background: linear-gradient(135deg, #66bb6a 0%, #4caf50 100%);
        color: white;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .solicitud-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .solicitud-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.15) !important;
        }

    .btn-primary {
        background: linear-gradient(135deg, #42a5f5 0%, #2196f3 100%);
        border: none;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #2196f3 0%, #1976d2 100%);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(33, 150, 243, 0.4);
        }
</style>

@code {
    private List<SolicitudServicio>? solicitudes;
    private bool cargando = false;

    private string? empleadoId;
    private string? empleadoNombre;

    protected override async Task OnInitializedAsync()
    {
        await ObtenerDatosEmpleado();
        await CargarMisServicios();
    }

    private async Task ObtenerDatosEmpleado()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                empleadoId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                empleadoNombre = user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;

                Logger.LogInformation($"Empleado autenticado: {empleadoNombre} (ID: {empleadoId})");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al obtener datos del empleado");
        }
    }

    private async Task CargarMisServicios()
    {
        try
        {
            cargando = true;

            // Obtener todas las solicitudes
            var response = await Http.GetAsync("api/solicitud");

            if (response.IsSuccessStatusCode)
            {
                var todasSolicitudes = await response.Content.ReadFromJsonAsync<List<SolicitudServicio>>() ?? new List<SolicitudServicio>();

                // Filtrar solo las que están en proceso y asignadas a este empleado
                solicitudes = todasSolicitudes
                    .Where(s => s.Estado == (int)EstadoSolicitud.EnProceso && s.EmpleadoId == empleadoId)
                    .ToList();

                Logger.LogInformation($"Mis servicios en proceso: {solicitudes.Count}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar mis servicios");
        }
        finally
        {
            cargando = false;
        }
    }
}
