@page "/servicios"
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject IJSRuntime JS
@inject ILogger<Servicios> Logger
@inject NavigationManager Navigation

<PageTitle>Gestión de Servicios</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center py-3">
                <div>
                    <button class="btn btn-light btn-sm me-3" @onclick='() => Navigation.NavigateTo("/admin")'>
                        <i class="fas fa-arrow-left me-2"></i>Volver
                    </button>
                    <h1 class="d-inline mb-0">
                        <i class="fas fa-tools me-2"></i>Gestión de Servicios
                    </h1>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid px-4 mt-4">
        <h1 class="page-title">
            <i class="fas fa-tools me-3"></i>Gestión de Servicios
        </h1>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-exclamation-circle me-2"></i>@errorMessage
                <button type="button" class="btn-close" @onclick="@(() => errorMessage = null)"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle me-2"></i>@successMessage
                <button type="button" class="btn-close" @onclick="@(() => successMessage = null)"></button>
            </div>
        }

        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="card-title mb-1">
                                    <i class="fas fa-list me-2"></i>Catálogo de Servicios
                                </h5>
                                <p class="text-muted mb-0">Administre los servicios disponibles en el sistema</p>
                            </div>
                            <button class="btn btn-primary btn-lg" @onclick="MostrarFormularioNuevo">
                                <i class="fas fa-plus me-2"></i>Nuevo Servicio
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (mostrarFormulario)
        {
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="fas @(esNuevo ? "fa-plus" : "fa-edit") me-2"></i>
                                @(esNuevo ? "Nuevo" : "Editar") Servicio
                            </h5>
                        </div>
                        <div class="card-body">
                            <EditForm Model="@servicioActual" OnValidSubmit="GuardarServicio">
                                <DataAnnotationsValidator />

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">
                                            <i class="fas fa-tools me-2"></i>Nombre del Servicio
                                        </label>
                                        <InputText class="form-control form-control-lg" @bind-Value="servicioActual.Nombre" placeholder="Nombre del servicio" />
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label fw-bold">
                                            <i class="fas fa-dollar-sign me-2"></i>Precio Base
                                        </label>
                                        <InputNumber class="form-control form-control-lg" @bind-Value="servicioActual.PrecioBase" placeholder="0.00" />
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label fw-bold">
                                            <i class="fas fa-align-left me-2"></i>Descripción
                                        </label>
                                        <InputTextArea class="form-control" rows="3" @bind-Value="servicioActual.Descripcion" placeholder="Descripción del servicio" />
                                    </div>
                                </div>

                                <div class="d-flex gap-2 mt-4">
                                    <button type="submit" class="btn btn-success" disabled="@guardando">
                                        @if (guardando)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        else
                                        {
                                            <i class="fas fa-save me-2"></i>
                                        }
                                        @(esNuevo ? "Guardar" : "Actualizar")
                                    </button>
                                    <button type="button" class="btn btn-secondary" @onclick="CancelarFormulario">
                                        <i class="fas fa-times me-2"></i>Cancelar
                                    </button>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    @if (cargando)
                    {
                        <div class="card-body text-center py-5">
                            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;"></div>
                            <p class="mt-3 text-muted">Cargando servicios...</p>
                        </div>
                    }
                    else if (servicios == null || !servicios.Any())
                    {
                        <div class="card-body text-center py-5">
                            <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                            <p class="text-muted">No hay servicios registrados</p>
                            <button class="btn btn-primary" @onclick="MostrarFormularioNuevo">
                                <i class="fas fa-plus me-2"></i>Agregar Primer Servicio
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th><i class="fas fa-tools me-2"></i>Nombre</th>
                                        <th><i class="fas fa-align-left me-2"></i>Descripción</th>
                                        <th><i class="fas fa-dollar-sign me-2"></i>Precio</th>
                                        <th class="text-end"><i class="fas fa-cog me-2"></i>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var servicio in servicios)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@servicio.Nombre</strong>
                                            </td>
                                            <td>@(string.IsNullOrEmpty(servicio.Descripcion) ? "Sin descripción" : servicio.Descripcion)</td>
                                            <td>
                                                <span class="badge bg-success fs-6">$@servicio.PrecioBase.ToString("N2")</span>
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary me-2" @onclick="@(() => EditarServicio(servicio))">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="@(() => EliminarServicio(servicio.Id))">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .page-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    }

    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

        .page-header h1 {
            font-size: 1.8rem;
            font-weight: 700;
            color: white;
        }

    .page-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 2rem;
    }

    .card {
        transition: transform 0.2s;
    }

        .card:hover {
            transform: translateY(-2px);
        }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

    .table tbody tr:hover {
        background-color: #f8f9fa;
        cursor: pointer;
    }
</style>

@code {
    private List<Servicio>? servicios;
    private Servicio servicioActual = new Servicio();
    private bool mostrarFormulario = false;
    private bool esNuevo = true;
    private bool cargando = true;
    private bool guardando = false;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await CargarServicios();
    }

    private async Task CargarServicios()
    {
        try
        {
            cargando = true;
            var response = await Http.GetAsync("api/servicio");

            if (response.IsSuccessStatusCode)
            {
                servicios = await response.Content.ReadFromJsonAsync<List<Servicio>>();
                Logger.LogInformation($"Servicios cargados: {servicios?.Count ?? 0}");
            }
            else
            {
                errorMessage = "Error al cargar los servicios";
                Logger.LogError($"Error al cargar servicios: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Logger.LogError(ex, "Error al cargar servicios");
        }
        finally
        {
            cargando = false;
        }
    }

    private void MostrarFormularioNuevo()
    {
        servicioActual = new Servicio();
        esNuevo = true;
        mostrarFormulario = true;
        errorMessage = null;
        successMessage = null;
    }

    private void EditarServicio(Servicio servicio)
    {
        servicioActual = new Servicio
        {
            Id = servicio.Id,
            Nombre = servicio.Nombre,
            Descripcion = servicio.Descripcion,
            PrecioBase = servicio.PrecioBase
        };
        esNuevo = false;
        mostrarFormulario = true;
        errorMessage = null;
        successMessage = null;
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        servicioActual = new Servicio();
        errorMessage = null;
    }

    private async Task GuardarServicio()
    {
        try
        {
            guardando = true;
            errorMessage = null;
            successMessage = null;

            HttpResponseMessage response;

            if (esNuevo)
            {
                response = await Http.PostAsJsonAsync("api/servicio", servicioActual);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"api/servicio/{servicioActual.Id}", servicioActual);
            }

            if (response.IsSuccessStatusCode)
            {
                successMessage = esNuevo ? "Servicio creado exitosamente" : "Servicio actualizado exitosamente";
                mostrarFormulario = false;
                await CargarServicios();
                servicioActual = new Servicio();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error al guardar: {errorContent}";
                Logger.LogError($"Error al guardar servicio: {response.StatusCode} - {errorContent}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Logger.LogError(ex, "Error al guardar servicio");
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarServicio(string? id)
    {
        if (string.IsNullOrEmpty(id)) return;

        if (!await JS.InvokeAsync<bool>("confirm", "¿Está seguro de eliminar este servicio?"))
            return;

        try
        {
            var response = await Http.DeleteAsync($"api/servicio/{id}");

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Servicio eliminado exitosamente";
                await CargarServicios();
            }
            else
            {
                errorMessage = "Error al eliminar el servicio";
                Logger.LogError($"Error al eliminar servicio: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Logger.LogError(ex, "Error al eliminar servicio");
        }
    }
}