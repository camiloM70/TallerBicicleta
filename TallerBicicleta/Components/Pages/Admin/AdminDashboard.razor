@page "/admin"
@attribute [Authorize(Roles = "Administrador")]
@using TallerBicicleta.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILogger<AdminDashboard> Logger


<PageTitle>Panel de Administración</PageTitle>
<div class="admin-container">
    <!-- Header con cerrar sesión -->
    <div class="admin-header">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center py-3">
                <h1 class="mb-0">
                    <i class="fas fa-user-shield me-3"></i>Panel de Administración
                </h1>
                <AuthorizeView>
                    <Authorized>
                        <div class="d-flex align-items-center">
                            <span class="text-white me-3 fw-bold">
                                <i class="fas fa-user-circle me-2"></i>@context.User.Identity?.Name
                            </span>
                            <button class="btn btn-light btn-sm" @onclick="CerrarSesion">
                                <i class="fas fa-sign-out-alt me-1"></i>Cerrar Sesión
                            </button>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </div>

    <!-- Contenido principal -->
    <div class="container-fluid mt-5 px-4">
        <div class="row mb-4">
            <div class="col-12">
                <p class="lead text-center">Bienvenido al sistema de gestión del taller</p>
            </div>
        </div>

        <div class="row g-4 justify-content-center">
            <!-- Card Empleados -->
            <div class="col-md-4">
                <div class="card text-white bg-primary shadow-lg h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h3 class="card-title mb-2">Empleados</h3>
                                <p class="card-text fs-5">Gestionar</p>
                            </div>
                            <i class="fas fa-users fa-4x opacity-50"></i>
                        </div>
                        <p class="mb-3">Administra los empleados del taller, asigna comisiones y gestiona información.</p>
                        <button class="btn btn-light btn-lg w-100" @onclick='() => Navigation.NavigateTo("/empleados")'>
                            <i class="fas fa-arrow-right me-2"></i>IR A EMPLEADOS
                        </button>
                    </div>
                </div>
            </div>

            <!-- Card Productos -->
            <div class="col-md-4">
                <div class="card text-white bg-success shadow-lg h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h3 class="card-title mb-2">Productos</h3>
                                <p class="card-text fs-5">Inventario</p>
                            </div>
                            <i class="fas fa-box fa-4x opacity-50"></i>
                        </div>
                        <p class="mb-3">Gestiona el inventario de productos, precios, stock y descripciones.</p>
                        <button class="btn btn-light btn-lg w-100" @onclick='() => Navigation.NavigateTo("/productos")'>
                            <i class="fas fa-arrow-right me-2"></i>IR A PRODUCTOS
                        </button>
                    </div>
                </div>
            </div>

            <!-- Card Ganancias -->
            <div class="col-md-4">
                <div class="card text-white shadow-lg h-100" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h3 class="card-title mb-2">Ganancias</h3>
                                <p class="card-text fs-5">Reportes</p>
                            </div>
                            <i class="bi bi-graph-up-arrow fa-4x opacity-50"></i>
                        </div>
                        <p class="mb-3">Visualiza reportes financieros, gráficas y análisis de ganancias del taller.</p>
                        <button class="btn btn-light btn-lg w-100" @onclick='() => Navigation.NavigateTo("/admin/ganancias")'>
                            <i class="bi bi-bar-chart me-2"></i>VER GANANCIAS
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    }

    .admin-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

        .admin-header h1 {
            font-size: 2rem;
            font-weight: 700;
        }

    .card {
        transition: transform 0.3s, box-shadow 0.3s;
        border: none;
    }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.3) !important;
        }

    .btn-light {
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-light:hover {
            transform: scale(1.05);
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }
</style>

@code {
    private void CerrarSesion()
    {
        try
        {
            if (AuthStateProvider is CustomAuthStateProvider customProvider)
            {
                customProvider.MarkUserAsLoggedOut();
                Logger.LogInformation("Administrador cerró sesión");
                Navigation.NavigateTo("/login", forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cerrar sesión");
        }
    }
}
