@page "/empleados"
@attribute [Authorize(Roles = "Administrador")]
@inject HttpClient Http
@inject ILogger<Empleados> Logger
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@using TallerBicicleta.Models


<PageTitle>Gestión de Empleados</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center py-3">
                <div>
                    <button class="btn btn-light btn-sm me-3" @onclick='() => Navigation.NavigateTo("/admin")'>
                        <i class="fas fa-arrow-left me-2"></i>Volver
                    </button>
                    <h1 class="d-inline mb-0">
                        <i class="fas fa-users me-2"></i>Gestión de Empleados
                    </h1>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid px-4 mt-4">
        <div class="row mb-4">
            <div class="col-12">
                <h1 class="page-title">Gestión de Empleados</h1>
            </div>
        </div>

        @if (errorMessage != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Error:</strong> @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        @if (successMessage != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>Éxito:</strong> @successMessage
                <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
            </div>
        }

        <div class="row mb-3">
            <div class="col-12">
                <button class="btn btn-primary btn-lg" @onclick="MostrarFormularioNuevo">
                    <i class="fas fa-plus-circle"></i> Nuevo Empleado
                </button>
            </div>
        </div>

        @if (mostrarFormulario)
        {
            <div class="card mb-4 shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@(empleadoActual.Id == null ? "Agregar Nuevo Empleado" : "Editar Empleado")</h4>
                </div>
                <div class="card-body">
                    <EditForm Model="@empleadoActual" OnValidSubmit="@GuardarEmpleado">
                        <DataAnnotationsValidator />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label fw-bold">Usuario:</label>
                                    <InputText class="form-control form-control-lg"
                                               @bind-Value="empleadoActual.NombreUsuario"
                                               placeholder="Ingrese nombre de usuario"
                                               disabled="@(empleadoActual.Id != null)" />
                                    <ValidationMessage For="@(() => empleadoActual.NombreUsuario)" />
                                </div>

                                <div class="form-group mb-3">
                                    <label class="form-label fw-bold">Contraseña:</label>
                                    <InputText type="password"
                                               class="form-control form-control-lg"
                                               @bind-Value="empleadoActual.Password"
                                               placeholder="Ingrese contraseña" />
                                    <ValidationMessage For="@(() => empleadoActual.Password)" />
                                </div>

                                <div class="form-group mb-3">
                                    <label class="form-label fw-bold">Nombre Completo:</label>
                                    <InputText class="form-control form-control-lg"
                                               @bind-Value="empleadoActual.NombreCompleto"
                                               placeholder="Ingrese nombre completo" />
                                    <ValidationMessage For="@(() => empleadoActual.NombreCompleto)" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="form-label fw-bold">Correo Electrónico:</label>
                                    <InputText type="email"
                                               class="form-control form-control-lg"
                                               @bind-Value="empleadoActual.CorreoElectronico"
                                               placeholder="correo@ejemplo.com" />
                                    <ValidationMessage For="@(() => empleadoActual.CorreoElectronico)" />
                                </div>

                                <div class="form-group mb-3">
                                    <label class="form-label fw-bold">Porcentaje Comisión (%):</label>
                                    <InputNumber class="form-control form-control-lg"
                                                 @bind-Value="porcentajeDisplay"
                                                 placeholder="60"
                                                 min="0"
                                                 max="100" />
                                    <small class="form-text text-muted">Ingrese un valor entre 0 y 100</small>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-12 text-center">
                                <button type="submit" class="btn btn-success btn-lg me-2" disabled="@guardando">
                                    @if (guardando)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    }
                                    <i class="fas fa-save"></i> Guardar
                                </button>
                                <button type="button" class="btn btn-secondary btn-lg" @onclick="CancelarFormulario">
                                    <i class="fas fa-times"></i> Cancelar
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        }

        <div class="card shadow">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0">Lista de Empleados</h4>
            </div>
            <div class="card-body">
                @if (cargando)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                        <p class="mt-3">Cargando empleados...</p>
                    </div>
                }
                else if (empleados == null || !empleados.Any())
                {
                    <div class="alert alert-info text-center" role="alert">
                        <i class="fas fa-info-circle fa-2x mb-3"></i>
                        <p class="mb-0">No hay empleados registrados.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>Nombre Completo</th>
                                    <th>Usuario</th>
                                    <th>Correo Electrónico</th>
                                    <th>Comisión</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var empleado in empleados)
                                {
                                    <tr>
                                        <td class="fw-bold">@empleado.NombreCompleto</td>
                                        <td>@empleado.NombreUsuario</td>
                                        <td>@empleado.CorreoElectronico</td>
                                        <td>@((empleado.PorcentajeComision * 100).ToString("0.00"))%</td>
                                        <td class="text-center">
                                            <button class="btn btn-warning btn-sm me-2"
                                                    @onclick="() => EditarEmpleado(empleado)">
                                                <i class="fas fa-edit"></i> Editar
                                            </button>
                                            <button class="btn btn-danger btn-sm"
                                                    @onclick="() => EliminarEmpleado(empleado)">
                                                <i class="fas fa-trash"></i> Eliminar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .page-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    }

    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

        .page-header h1 {
            font-size: 1.8rem;
            font-weight: 700;
            color: white;
        }
</style>

@code {
    private List<Empleado>? empleados;
    private Empleado empleadoActual = new Empleado();
    private bool mostrarFormulario = false;
    private bool cargando = true;
    private bool guardando = false;
    private string? errorMessage;
    private string? successMessage;
    private double porcentajeDisplay = 60;
    

    protected override async Task OnInitializedAsync()
    {
        await CargarEmpleados();
    }

    private async Task CargarEmpleados()
    {
        try
        {
            cargando = true;
            errorMessage = null;
            empleados = await Http.GetFromJsonAsync<List<Empleado>>("api/empleado");
            Logger.LogInformation($"Empleados cargados: {empleados?.Count ?? 0}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al cargar empleados");
            errorMessage = "Error al cargar la lista de empleados. Por favor, intente nuevamente.";
            empleados = new List<Empleado>();
        }
        finally
        {
            cargando = false;
        }
    }

    private void MostrarFormularioNuevo()
    {
        empleadoActual = new Empleado
        {
            PorcentajeComision = 0.80 // 80% por defecto (empleado se queda con 80%, dueño con 20%)
        };
        porcentajeDisplay = 80;
        mostrarFormulario = true;
        errorMessage = null;
        successMessage = null;
    }

    private void EditarEmpleado(Empleado empleado)
    {
        empleadoActual = new Empleado
        {
            Id = empleado.Id,
            NombreUsuario = empleado.NombreUsuario,
            Password = empleado.Password,
            NombreCompleto = empleado.NombreCompleto,
            CorreoElectronico = empleado.CorreoElectronico,
            PorcentajeComision = empleado.PorcentajeComision,
            Rol = empleado.Rol,
            Activo = empleado.Activo
        };
        porcentajeDisplay = empleado.PorcentajeComision * 100;
        mostrarFormulario = true;
        errorMessage = null;
        successMessage = null;
    }

    private async Task GuardarEmpleado()
    {
        try
        {
            guardando = true;
            errorMessage = null;
            successMessage = null;

            // Convertir porcentaje de display (0-100) a double (0-1)
            empleadoActual.PorcentajeComision = porcentajeDisplay / 100.0;

            HttpResponseMessage response;

            if (string.IsNullOrEmpty(empleadoActual.Id))
            {
                // Crear nuevo empleado
                response = await Http.PostAsJsonAsync("api/empleado", empleadoActual);
            }
            else
            {
                // Actualizar empleado existente
                response = await Http.PutAsJsonAsync($"api/empleado/{empleadoActual.Id}", empleadoActual);
            }

            if (response.IsSuccessStatusCode)
            {
                successMessage = empleadoActual.Id == null
                    ? "Empleado creado exitosamente"
                    : "Empleado actualizado exitosamente";

                mostrarFormulario = false;
                await CargarEmpleados();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error al guardar: {error}";
                Logger.LogError($"Error al guardar empleado: {error}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al guardar empleado");
            errorMessage = $"Error al guardar el empleado: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarEmpleado(Empleado empleado)
    {
        if (empleado.Id == null) return;

        try
        {
            var confirmado = await JSRuntime.InvokeAsync<bool>("confirm",
                $"¿Está seguro de eliminar al empleado '{empleado.NombreCompleto}'?");

            if (!confirmado) return;

            errorMessage = null;
            successMessage = null;

            var response = await Http.DeleteAsync($"api/empleado/{empleado.Id}");

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Empleado eliminado exitosamente";
                await CargarEmpleados();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error al eliminar: {error}";
                Logger.LogError($"Error al eliminar empleado: {error}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al eliminar empleado");
            errorMessage = $"Error al eliminar el empleado: {ex.Message}";
        }
    }

    private void CancelarFormulario()
    {
        mostrarFormulario = false;
        empleadoActual = new Empleado();
        errorMessage = null;
        successMessage = null;
    }
}
